@echo off
rem Configures and builds the C sources generated by "gradle generateC" (x64 or ARM64)
setlocal
cd /d "%~dp0"
set "PLATFORM=%~1"
if "%PLATFORM%"=="" (
	if /i "%PROCESSOR_ARCHITECTURE%"=="ARM64" (set "PLATFORM=ARM64") else (set "PLATFORM=x64")
)
set "CMAKE="
if defined CMAKE_EXE if exist "%CMAKE_EXE%" set "CMAKE=%CMAKE_EXE%"
if not defined CMAKE for /f "delims=" %%i in ('where cmake.exe 2^>nul') do if not defined CMAKE set "CMAKE=%%i"
if not defined CMAKE for %%d in ("%ProgramFiles%\CMake\bin" "%LocalAppData%\Programs\CMake\bin") do if not defined CMAKE if exist "%%~d\cmake.exe" set "CMAKE=%%~d\cmake.exe"
set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
if not defined CMAKE if exist "%VSWHERE%" for /f "delims=" %%i in ('"%VSWHERE%" -latest -products * -find Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe') do if not defined CMAKE set "CMAKE=%%i"
if not defined CMAKE (
	echo cmake.exe not found, set CMAKE_EXE
	exit /b 1
)
"%CMAKE%" -S . -B build\cmake -A %PLATFORM% || exit /b 1
"%CMAKE%" --build build\cmake --config Release --parallel || exit /b 1
echo Done: %~dp0bin\Release\monitorgc.exe
